--         CONFIGURAÇÕES
-- ==========================================
local CONFIG = {
    SelectedMob  = nil,   -- nil = qualquer um
    AttackDelay  = 0.08,
    SkillZ       = true,
    SkillX       = true,
    SkillC       = true,
    SkillZDelay  = 2,
    SkillXDelay  = 3,
    SkillCDelay  = 5,
}

-- ==========================================
--         SERVIÇOS / VARIÁVEIS
-- ==========================================
local Players = game:GetService("Players")
local VIM     = game:GetService("VirtualInputManager")
local LP      = Players.LocalPlayer
local Char, Hum, Root

local function refreshChar()
    Char = LP.Character
    if not Char then return false end
    Hum  = Char:FindFirstChildOfClass("Humanoid")
    Root = Char:FindFirstChild("HumanoidRootPart")
    return Hum ~= nil and Root ~= nil
end
refreshChar()

local farmActive    = false
local currentTarget = nil
local lastZ, lastX, lastC = 0, 0, 0

-- ==========================================
--         FUNÇÕES CORE
-- ==========================================

local function getRoot(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Root")
        or model:FindFirstChildOfClass("BasePart")
end

-- Encontra o mob selecionado mais próximo.
-- Se CONFIG.SelectedMob estiver definido, SÓ busca aquele nome.
-- Nunca cai em outro mob.
local function findTarget()
    local ES = workspace:FindFirstChild("EnemyService")
    if not ES or not Root then return nil end

    local best, bestDist = nil, math.huge

    for _, model in ipairs(ES:GetChildren()) do
        -- Extrai nome real após "] " ex: "[Lv.4000] Frost Minion" -> "Frost Minion"
        if CONFIG.SelectedMob then
            local realName = model.Name:match("%]%s*(.+)$") or model.Name
            if realName ~= CONFIG.SelectedMob then
                continue
            end
        end

        local hum  = model:FindFirstChildOfClass("Humanoid")
        local root = getRoot(model)
        if hum and root and hum.Health > 0 then
            local dist = (Root.Position - root.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                best = model
            end
        end
    end
    return best
end

local function teleportTo(pos)
    -- Teleporta levemente acima e à frente do alvo
    Root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
end

local function clickM1()
    pcall(function()
        VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
        task.wait(0.06)
        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

local function pressKey(keyCode)
    pcall(function()
        VIM:SendKeyEvent(true,  keyCode, false, game)
        task.wait(0.08)
        VIM:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- ==========================================
--         LOOP PRINCIPAL
-- ==========================================

local function farmLoop()
    while farmActive do
        -- Aguarda personagem vivo
        if not refreshChar() or Hum.Health <= 0 then
            task.wait(2)
            continue
        end

        local target = findTarget()

        if target then
            currentTarget = target
            local root = getRoot(target)
            local hum  = target:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                -- SEMPRE teleporta até o alvo (garante que vai até boss)
                teleportTo(root.Position)
                task.wait(0.06)

                -- Ataca com M1
                clickM1()

                -- Skills Z / X / C com cooldown
                local now = tick()
                if CONFIG.SkillZ and (now - lastZ) >= CONFIG.SkillZDelay then
                    pressKey(Enum.KeyCode.Z)
                    lastZ = now
                end
                if CONFIG.SkillX and (now - lastX) >= CONFIG.SkillXDelay then
                    pressKey(Enum.KeyCode.X)
                    lastX = now
                end
                if CONFIG.SkillC and (now - lastC) >= CONFIG.SkillCDelay then
                    pressKey(Enum.KeyCode.C)
                    lastC = now
                end
            end
        else
            -- Mob selecionado não encontrado no mapa — aguarda reaparecer
            currentTarget = nil
            task.wait(1)
        end

        task.wait(CONFIG.AttackDelay)
    end
    currentTarget = nil
end

-- Anti-AFK
task.spawn(function()
    while true do
        task.wait(55)
        if farmActive then
            pcall(function()
                VIM:SendKeyEvent(true,  Enum.KeyCode.W, false, game)
                task.wait(0.1)
                VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            end)
        end
    end
end)

-- Reconecta ao respawn
LP.CharacterAdded:Connect(function(c)
    Char = c
    Hum  = c:WaitForChild("Humanoid")
    Root = c:WaitForChild("HumanoidRootPart")
    if farmActive then
        task.wait(2)
        task.spawn(farmLoop)
    end
end)

